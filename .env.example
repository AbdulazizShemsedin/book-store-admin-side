# Backend API Base URL (e.g. http://localhost:8000 or staging server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo Mode Switch (true = interactive development/preview mock backend via MSW, false = real backend)
# Set to true for local development without backend and Vercel preview/demo deployments.
# Set to false for the eventual real production deployment.
NEXT_PUBLIC_DEMO_MODE=true

# Optional API timeout in milliseconds (defaults to 30000)
NEXT_PUBLIC_API_TIMEOUT_MS=30000

