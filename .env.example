# Backend API Base URL (e.g. http://localhost:8000 or staging server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Development Mock API Switch (true = development mock via MSW, false = real backend)
# Only active during development (NODE_ENV !== 'production').
NEXT_PUBLIC_USE_MOCK_API=true

# Optional API timeout in milliseconds (defaults to 30000)
NEXT_PUBLIC_API_TIMEOUT_MS=30000
